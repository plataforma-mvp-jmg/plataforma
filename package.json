{
  "name": "plataforma",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "verify": "pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "dev": "pnpm --filter \"./packages/*\" --filter @plataforma/shell build && pnpm --parallel --filter \"./apps/*\" dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0"
  }
}
