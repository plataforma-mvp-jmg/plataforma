{
  "name": "@plataforma/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../infra/local/.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "start": "node dist/server.js",
    "generar-clave-jwt": "tsx scripts/generar-clave-jwt.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/reply-from": "12.8.3",
    "@fastify/static": "10.1.11",
    "@plataforma/auth": "workspace:*",
    "@plataforma/contracts": "workspace:*",
    "fastify": "5.12.8",
    "jose": "6.2.17",
    "openid-client": "6.9.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@plataforma/config": "workspace:*",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
