# Copiar a infra/local/deployer.env (está en .gitignore) y completar. Nunca commitear la clave.
ORG=plataforma-mvp-jmg
ENTORNO=staging
# GitHub App "plataforma-mvp-jmg-deployer": Deployments RW, Actions R, Metadata R; sin webhook.
DEPLOYER_CLIENT_ID=
# Ruta ABSOLUTA al .pem de la App, fuera del repo (ej. C:/Users/<usuario>/.plataforma/deployer.pem)
DEPLOYER_CLAVE_PATH=
REGISTRY_DIR=../../registry
MAPA_PATH=../../infra/local/estado/despliegues.staging.json
# Rango de puertos locales (solo 127.0.0.1) para los contenedores de staging
PUERTOS=4100-4199
INTERVALO_SEG=20
# Cómo ve el contenedor a la API de plataforma (para verificar el JWT del gateway)
MODULO_PLATFORM_JWKS_URL=http://host.docker.internal:8088/.well-known/jwks.json
MODULO_PLATFORM_ISSUER=http://localhost:8088
# I4-4 — base de los módulos (ADR 0015). Session pooler de Supabase con la contraseña de la base
# (codificada para URL) y una clave maestra de 48 hex para derivar las contraseñas de los roles.
# Nunca en Git ni en el chat.
# DB_ADMIN_URL=postgresql://postgres.<project-ref>:<contraseña>@aws-1-<region>.pooler.supabase.com:5432/postgres
# DB_CLAVE_MAESTRA=
