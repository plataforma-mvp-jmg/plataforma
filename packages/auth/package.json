{
  "name": "@plataforma/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Verificación del JWT de plataforma para módulos (contrato E2).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "jose": "6.2.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@plataforma/config": "workspace:*",
    "@types/node": "26.6.7",
    "@vitest/coverage-v8": "5.1.1",
    "fastify": "5.12.8",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
