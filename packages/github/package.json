{
  "name": "@plataforma/github",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cliente REST mínimo de GitHub y autenticación como GitHub App (aprovisionador y deployer).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@plataforma/config": "workspace:*",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
